# Copy to backend/.env to override defaults. All values are optional.

# Server
JUTSU_HOST=127.0.0.1
JUTSU_PORT=8000
# Comma separated list of allowed browser origins
JUTSU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage (relative paths are resolved from the backend/ directory)
JUTSU_CONFIG_DIR=config
JUTSU_DATASET_DIR=dataset
JUTSU_MODEL_DIR=trained_models
JUTSU_DATABASE_PATH=data/jutsu_arena.sqlite3

# Training
JUTSU_MIN_SAMPLES_PER_CLASS=20
JUTSU_RECOMMENDED_SAMPLES_PER_CLASS=80
JUTSU_FOREST_TREES=150

# Recognition stability
JUTSU_RELEASE_MS=250
JUTSU_SIGN_COOLDOWN_MS=300
JUTSU_MIN_HOLD_FRAMES=2
# Score smoothing window in ms (0 = off)
JUTSU_SCORE_SMOOTHING_MS=100
# Saved samples a sign needs before they personalise the built-in recogniser
JUTSU_CALIBRATION_MIN_SAMPLES=8

# Gameplay
JUTSU_ACTIVATION_LOCKOUT_MS=2500
JUTSU_SESSION_TTL_SECONDS=1800
