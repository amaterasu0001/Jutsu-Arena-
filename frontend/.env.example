# Copy to frontend/.env to override defaults. All values are optional.

# Where the Vite dev server forwards /api requests (the FastAPI backend).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL the browser uses for API calls. Leave as /api to go through the
# Vite proxy, or set an absolute URL (e.g. http://127.0.0.1:8000/api).
VITE_API_BASE_URL=/api

# MediaPipe assets. Defaults use the local copies created by the setup script,
# falling back to the public CDN when they are missing.
VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
VITE_HAND_MODEL_URL=/models/hand_landmarker.task

# Set to true only if left/right labels come out swapped on your camera.
VITE_SWAP_HANDEDNESS=false
